# Copy to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=5000
# The frontend's public address. Links in emails (password reset) point here.
CLIENT_URL=http://localhost:3001
# Extra browser origins allowed to use the API and Socket.IO, comma-separated
# (config/cors.js). CLIENT_URL and same-origin are always allowed; localhost
# is allowed only when NODE_ENV is not "production".
CORS_ORIGINS=
# Proxies in front of this server (config/proxy.js), which decides the client
# IP every rate limit counts. Leave empty when Node faces clients directly;
# behind Nginx or a load balancer set the hop count, e.g. 1. "true" is refused:
# it would let any client pick its own IP in X-Forwarded-For.
TRUST_PROXY=

# Database / cache
MONGO_URI=mongodb://127.0.0.1:27017/fuelmart
# Redis for distributed locks and shared rate limits. Empty = in-process
# fallback (fine for one server instance).
REDIS_URL=
# "true" refuses to run without Redis locking (defaults on when NODE_ENV=production
# -- see src/services/core/lock.js).
LOCK_REQUIRE_DISTRIBUTED=

# Auth
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# The server refuses to start with a missing secret, one under 32 characters,
# or one under 64 characters when NODE_ENV=production (src/config/auth.js).
# Session: short-lived access token + long-lived refresh token, both in
# httpOnly SameSite=Strict cookies.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Secure cookies (HTTPS only). Empty = true in production, false elsewhere.
COOKIE_SECURE=

# Fill time per fuel (src/config/fuelDurations.js):
#   seconds = setup + seconds-per-unit x quantity (litres, kg for CNG)
# Empty = defaults: Petrol/Diesel 6 s + 3.4 s/L, CNG 60 s + 12 s/kg.
FUEL_SETUP_SECONDS_PETROL=
FUEL_SECONDS_PER_UNIT_PETROL=
FUEL_SETUP_SECONDS_DIESEL=
FUEL_SECONDS_PER_UNIT_DIESEL=
FUEL_SETUP_SECONDS_CNG=
FUEL_SECONDS_PER_UNIT_CNG=
# A typical fill when no quantity is known (station lists). Defaults 40 / 40 / 300.
FUEL_SERVICE_SECONDS_PETROL=
FUEL_SERVICE_SECONDS_DIESEL=
FUEL_SERVICE_SECONDS_CNG=

# Rate limiting (src/services/security/rateLimiter.js)
API_RATE_LIMIT_PER_MINUTE=300
VENDOR_ACCESS_ATTEMPTS_PER_IP=
RATE_LIMIT_REDIS_TIMEOUT_MS=

# Security events are kept this many days (src/models/SecurityEvent.js)
SECURITY_EVENT_RETENTION_DAYS=

# Socket.IO event logging in the console; "off" to silence
RT_LOG=

# Payments. Customers pay at the petrol pump; online payment (Razorpay) is off
# unless ONLINE_PAYMENTS_ENABLED=true -- set that only once real keys are below.
ONLINE_PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks: the secret you choose when adding
# https://<your-api>/api/webhooks/razorpay (events: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=
UPI_ID=
UPI_PAYEE_NAME=

# Email (verification, vendor approval, password reset). Any SMTP provider works;
# e.g. Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=<API key>.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=FuelMart
SMTP_FROM_EMAIL=
# Older names still accepted when SMTP_USER / SMTP_PASS are empty
EMAIL_USER=
EMAIL_PASS=

# Maps (not read by the backend code today; kept for the maps integration)
GOOGLE_MAPS_API_KEY=

# Tests only (test/helpers/testDb.js). The test database name must contain "test".
TEST_MONGO_URI=mongodb://127.0.0.1:27017/fuelmart_test
TEST_API_URL=http://127.0.0.1:5055
TEST_REDIS_URL=
