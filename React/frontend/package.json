{
  "name": "fuelmart-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FuelMart frontend: React + TypeScript + Vite + Tailwind + Zustand + Socket.IO client.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
