<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/fuelmart_red</item>
        <item name="colorPrimaryDark">@color/fuelmart_red_dark</item>
        <item name="colorAccent">@color/fuelmart_red</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="colorAccent">@color/fuelmart_red</item>
    </style>

    <!-- Launch screen: Android 12+ uses the splash attributes, older versions the background. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash_fuelmart</item>
        <item name="windowSplashScreenBackground">@color/fuelmart_red</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fm_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
